diff --git a/.env.example b/.env.example
index f183361..4116c00 100644
--- a/.env.example
+++ b/.env.example
@@ -2,3 +2,26 @@
 POSTGRES_PASSWORD=replace-with-local-random-password
 POSTGRES_PORT=5432
 # DATABASE_URL을 설정하면 위 항목보다 우선한다. OAuth 키는 이번 단위에 필요 없다.
+
+# ---- AI 제공자 (F1 runtime) ----
+# 비우면 AI 미연결(not_configured). claude 또는 ollama. 가짜 결과로 대체하지 않는다.
+AI_PROVIDER=
+# [ollama] 이 컴퓨터의 Ollama만 허용(loopback). 모델 태그는 'ollama list'로 확인해 적는다.
+OLLAMA_BASE_URL=http://localhost:11434
+OLLAMA_MODEL=
+# 기능별 모델(선택): OLLAMA_MODEL_ANALYSIS / _DRAFT / _SEARCH / _WEEKLY_REPORT / _SCAN
+# 형식 강제: schema(기본) / json / none. Qwen3의 생각 출력을 끄려면 OLLAMA_THINK=false
+OLLAMA_FORMAT=schema
+OLLAMA_THINK=
+OLLAMA_TIMEOUT_SECONDS=120
+OLLAMA_RETRIES=1
+# [claude] 메일이 외부(Anthropic)로 전송된다. 보안 확인 전까지 테스트 데이터만 사용.
+# 아래 확인 값을 true로 적어야 Claude가 켜진다. 키는 실제 .env에만 적고 커밋하지 않는다.
+AI_CLAUDE_TEST_DATA_ONLY=
+ANTHROPIC_API_KEY=
+CLAUDE_MODEL=claude-opus-5-5
+# 기능별 모델(선택): CLAUDE_MODEL_ANALYSIS / _DRAFT / _SEARCH / _WEEKLY_REPORT / _SCAN
+CLAUDE_EFFORT=low
+# [임베딩] 제공자와 관계없이 이 컴퓨터의 Ollama 사용 ('ollama pull bge-m3')
+EMBEDDING_MODEL=bge-m3
+EMBEDDING_DIMENSIONS=1024
